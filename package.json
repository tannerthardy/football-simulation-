{
  "name": "gridiron-engine",
  "version": "0.1.0",
  "description": "Physics-driven American football simulation engine with Football-Manager-style depth",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile out/typescript/typecheck.tsbuildinfo",
    "test": "vitest run --project core --project core-defaults",
    "test:workflows": "vitest run --project workflows --maxWorkers=1",
    "test:integration": "vitest run --project workflows --project integration --maxWorkers=2",
    "test:research": "vitest run --project research",
    "test:all": "vitest run --maxWorkers=3",
    "baseline:info": "node scripts/baseline.mjs --info",
    "baseline:run": "node scripts/baseline.mjs",
    "baseline:verify": "node scripts/baseline.mjs --verify",
    "screen:roster": "node scripts/baseline.mjs --candidate -- node --import tsx scripts/roster-screen.ts",
    "sim:play": "tsx scripts/sim-play.ts",
    "sim:game": "tsx scripts/sim-game.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "scorecard": "node --import tsx scripts/scorecard/run.ts",
    "replay": "tsx scripts/export-replay.ts",
    "film-pack": "node --import tsx scripts/film-pack.ts",
    "film-pairs": "node --import tsx scripts/film-pairs.ts",
    "weird": "node --import tsx scripts/weird-film.ts",
    "lab": "node --import tsx lab-app/server.ts",
    "lab:replay": "node --import tsx lab-app/replay-cli.ts",
    "test:data": "python3 -m unittest discover -s test -p 'test_*.py'",
    "nfl:fetch": "python3 -I scripts/data/fetch_nfl_data.py",
    "mech:nfl": "python3 -I scripts/mechanics/nfl_bdb2025.py --plays-out out/mechanics/nfl-plays.jsonl.gz && python3 -I scripts/mechanics/nfl_bdb2019.py && python3 -I scripts/mechanics/nfl_bdb2023.py && python3 -I scripts/mechanics/nfl_bdb2026.py",
    "mech:sim": "node --import tsx scripts/mechanics/sim-export.ts && python3 -I scripts/mechanics/measure.py out/mechanics/sim-plays.jsonl.gz out/mechanics/sim.json",
    "mech:report": "python3 -I scripts/mechanics/compare.py --guard data/reviews/mechanics/guard.json",
    "ref": "node scripts/ref.mjs",
    "ref:report": "node scripts/ref-report.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
