{
  "name": "gridiron-engine",
  "version": "0.1.0",
  "description": "Physics-driven American football simulation engine with Football-Manager-style depth",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project core",
    "test:integration": "vitest run --project integration --maxWorkers=1",
    "test:research": "vitest run --project research",
    "test:all": "vitest run --maxWorkers=1",
    "sim:play": "tsx scripts/sim-play.ts",
    "sim:game": "tsx scripts/sim-game.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "replay": "tsx scripts/export-replay.ts",
    "test:data": "python3 -m unittest discover -s test -p 'test_*.py'",
    "nfl:fetch": "python3 -I scripts/data/fetch_nfl_data.py",
    "mech:nfl": "python3 -I scripts/mechanics/nfl_bdb2025.py --plays-out out/mechanics/nfl-plays.jsonl.gz",
    "mech:sim": "node --import tsx scripts/mechanics/sim-export.ts && python3 -I scripts/mechanics/measure.py out/mechanics/sim-plays.jsonl.gz out/mechanics/sim.json",
    "mech:report": "python3 -I scripts/mechanics/compare.py --guard data/reviews/mechanics/guard.json"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
