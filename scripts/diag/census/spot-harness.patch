+/** CENSUS HARNESS ONLY (scripts/diag/census/spot-harness.patch; never applied to the engine): the day-one spot arm. Each called coverage becomes the base of its family
+ * (cover0 / cover1 / cover2man -> cover1; cover2 / tampa2 -> cover2; cover3 -> cover3; cover4 / cover6 -> cover4), a pressure that brings its own coverage keeps its rushers but not that coverage, zone calls
+ * play `zoneStyle = 'spot'` (a landmark drop, no #1/#2/#3 rule) and the call is installed as called (no structure checks, no quarters check, no Zeus). */
+function censusSpot(call: DefensivePlayCall): DefensivePlayCall {
+  const fam = call.coverage.family as string;
+  const to = fam === 'cover2' || fam === 'tampa2' ? 'cover2' : fam === 'cover3' ? 'cover3' : fam === 'cover4' || fam === 'cover6' ? 'cover4' : 'cover1';
+  const cov = COVERAGE_BY_ID[to];
+  const pressure = call.pressure?.coverage ? { ...call.pressure, coverage: undefined } : call.pressure; // keeps the rushers (a creep needs its blitzer), drops the coverage it brings
+  return { ...call, coverage: cov, pressure, zeus: undefined, check: undefined, zoneStyle: cov.man ? call.zoneStyle : 'spot', label: `${call.label} → ${cov.name} (spot)` };
+}
