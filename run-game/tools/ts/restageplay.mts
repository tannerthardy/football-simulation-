import { readFileSync } from 'node:fs';
const root = process.cwd();
const { PlaySim } = await import(root + '/src/sim/playsim.ts');
const { restoreSetup } = await import(root + '/scripts/diag/saved-play.ts');
const idx = Number(process.argv[2]);
const plays = [...JSON.parse(readFileSync('/home/user/fs-rel/out/matched-restage/seed7.json', 'utf8')), ...JSON.parse(readFileSync('/home/user/fs-rel/out/matched-restage/seed8.json', 'utf8'))];
const p = plays[idx]; const sim: any = new PlaySim(restoreSetup(Buffer.from(p.setup, 'base64')));
const r = sim.run();
const nm = (i: any) => i === undefined ? '' : sim.agents[i].slot;
console.log(p.call, r.yards.toFixed(1), r.outcome);
console.log(sim.events.filter((e: any) => ['carrier_contact','tackle','broke_contact','handoff','engage','release','shed'].some(k => e.type.includes(k)) || e.type === 'missed_tackle').slice(0, 30).map((e: any) => `${e.t} ${e.type} ${nm(e.a)}>${nm(e.b)}`).join(' | '));
