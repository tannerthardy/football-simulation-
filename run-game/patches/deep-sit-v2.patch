+/** DEEP_SIT (off): the ground a deep defender gives up while he turns and
+ * gets to the stem's speed, from his own sprint law v = vmax - (vmax - v0)
+ * e^(-t/tau), rather than the speed deficit times the whole time constant.
+ * Off, the guard charges (target - v0)(turn + tau): about 4.5 yd for a sitting
+ * DB against a 3 yd/s stem, where his body loses about 1.5. */
+const DEEP_SIT = process.env.DEEP_SIT === '1';
+
+/** Yards lost to a receiver running at `target` while a defender moving at
+ * `v0` (along the same line) keeps that speed through a `turn` s hip turn and
+ * then sprints up to `target`. */
+export function sprintLoss(v0: number, target: number, vmax: number, tau: number, turn: number): number {
+  if (target <= v0) return 0;
+  const top = Math.max(target + 1e-6, vmax);
+  const t = tau * Math.log((top - v0) / (top - target));
+  const covered = top * t - (top - v0) * tau * (1 - Math.exp(-t / tau));
+  return Math.max(0, target * (turn + t) - v0 * turn - covered);
+}
