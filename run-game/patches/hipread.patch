+/** The kick block read by the man's hip, in the runner's pictures of the
+ * puller and the man on him: logged (bounce outside the puller) when the man
+ * stands inside the puller and is not being driven out; otherwise kicked out.
+ * Two engaged bodies a few tenths of a yard apart do not say which by
+ * position alone; the man's motion does. */
+export function kickLogged(puller: Pick<Perceived, 'pos'>, man: Pick<Perceived, 'pos' | 'vel'>, side: number): boolean {
+  return (man.pos.y - puller.pos.y) * side < 0 && man.vel.y * side <= 0;
+}
