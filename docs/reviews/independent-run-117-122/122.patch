+    } finally { spy.mockRestore(); }
+  });
+
+  it.each([1, -1])('never reads private teammate bodies through the production hook in mirror %s', mirror => {
+    const s = scene(mirror);
+    expect(() => s.run()).not.toThrow();
+  });
+});
