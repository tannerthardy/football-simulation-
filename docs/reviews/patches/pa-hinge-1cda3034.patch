+  const dir = sim.attackDir(sim.offense[0].team);
+  if (endMan) return { x: snapX - dir * 2 * STEP, y: homeY + side * STEP, facing: Math.atan2(side, dir) };
+  return { x: snapX, y: homeY + side * 2 * STEP, facing: Math.atan2(side * 0.5, dir) };
