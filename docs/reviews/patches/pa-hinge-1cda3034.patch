+          if (Math.hypot(rA.pos.x - a.pos.x, rA.pos.y - a.pos.y) < contactPA + 0.15 && sim.engage(a, rA, 'pass')) return stand();
+        }
+        a.tags.add(endMan ? 'pa-hinge' : 'pa-reach');
+        return goTo(a, spot, { speed: 0.8, facing: spot.facing });
