diff --git a/scripts/diag/pass-operators/pa-backside-trace.mts b/scripts/diag/pass-operators/pa-backside-trace.mts
new file mode 100644
index 00000000..01ea4d9d
--- /dev/null
+++ b/scripts/diag/pass-operators/pa-backside-trace.mts
@@ -0,0 +1,36 @@
+// Why play action's backside end beats the tackle he is engaged with (follow-up to pa-backside.mts; the QB lane's grid:
+// gun_doubles_11, eight coverages, rosters 3 / 7 / 11 / 19, seeds 1-6, CONCEPT_DROPS=1 QB_FOOTWORK=1). PA (pa_flood,
+// pa_post_dig, pa_shot) against dropbacks (post_cross, seam_slant, flood). At 1.0 / 1.5 / 2.0 s, p50: the QB's depth
+// behind the line and his width toward DE_W's side of the ball (+ = toward DE_W), the LT's (DE_W's blocker's) depth and
+// width from his snap spot (+ = outside), DE_W's depth past the line and his offset outside the LT (+ = outside him),
+// DE_W's distance to the QB; the share where the engagement has ended by 2.0 s, and the LT's stance at 0.3 s.
+// usage: CONCEPT_DROPS=1 QB_FOOTWORK=1 node --import tsx scripts/diag/pass-operators/pa-backside-trace.mts
+const W = process.cwd();
+const { PlaySim } = await import(`${W}/src/sim/playsim.ts`);
+const { nativeTraceSetup } = await import(`${W}/scripts/diag/command-trace.ts`);
+const T = [1.0, 1.5, 2.0];
+const rows: any[] = [];
+for (const concept of ['pa_flood', 'pa_post_dig', 'pa_shot', 'post_cross', 'seam_slant', 'flood'])
+  for (const coverage of ['cover1', 'cover2man', 'cover2', 'tampa2', 'cover3', 'cover3_match', 'cover4', 'cover6']) for (const roster of [3, 7, 11, 19]) for (const seed of [1, 2, 3, 4, 5, 6]) {
+    let sim: any; try { sim = new PlaySim(nativeTraceSetup({ coverage, concept, seed, roster, formation: 'gun_doubles_11', flip: false })); } catch { continue; }
+    const de = sim.defense.find((d: any) => d.slot === 'DE_W'), lt = sim.slot('LT'); if (!de || !lt) continue;
+    const dir = sim.attackDir(sim.offense[0].team), side = Math.sign(de.pos.y - sim.ballY) || 1, lt0 = { ...lt.pos };
+    const r: any = { pa: concept.startsWith('pa_'), at: {}, stance: null, ended: false };
+    while (sim.phase === 'live' && sim.t < 2.05) {
+      const t0 = sim.t; sim.tick();
+      if (r.stance === null && sim.t >= 0.3) r.stance = lt.stance;
+      for (const k of T) if (t0 < k && sim.t >= k && sim.throwAt < 0) r.at[k] = {
+        qbD: (sim.los - sim.qb.pos.x) * dir, qbW: (sim.qb.pos.y - sim.ballY) * side,
+        ltD: (lt0.x - lt.pos.x) * dir, ltW: (lt.pos.y - lt0.y) * side,
+        deD: (sim.los - de.pos.x) * dir, deOut: (de.pos.y - lt.pos.y) * side, deQb: Math.hypot(de.pos.x - sim.qb.pos.x, de.pos.y - sim.qb.pos.y) };
+      if (sim.t >= 1.3 && !de.engagement && !r.ended && r.wasEng) r.ended = true;
+      if (de.engagement) r.wasEng = true;
+    }
+    rows.push(r);
+  }
+const q = (v: number[]) => { const z = v.filter(Number.isFinite).sort((a, b) => a - b); return z.length ? z[Math.floor((z.length - 1) / 2)].toFixed(2) : '-'; };
+for (const pa of [true, false]) {
+  const S = rows.filter((r) => r.pa === pa);
+  console.log(`${pa ? 'PA' : 'dropback'} (n ${S.length}): LT stance at 0.3 s ${JSON.stringify(S.reduce((m: any, r) => (m[r.stance] = (m[r.stance] ?? 0) + 1, m), {}))} | engagement ended after 1.3 s ${(100 * S.filter((r) => r.ended).length / S.length).toFixed(0)}%`);
+  for (const k of T) { const R = S.filter((r) => r.at[k]); console.log(`  ${k} s (n ${R.length}): QB depth ${q(R.map((r) => r.at[k].qbD))} width to DE_W's side ${q(R.map((r) => r.at[k].qbW))} | LT depth ${q(R.map((r) => r.at[k].ltD))} width ${q(R.map((r) => r.at[k].ltW))} | DE_W depth ${q(R.map((r) => r.at[k].deD))} outside the LT ${q(R.map((r) => r.at[k].deOut))} | DE_W to QB ${q(R.map((r) => r.at[k].deQb))}`); }
+}
diff --git a/scripts/diag/pass-operators/pa-backside.mts b/scripts/diag/pass-operators/pa-backside.mts
new file mode 100644
index 00000000..e1067f4f
--- /dev/null
+++ b/scripts/diag/pass-operators/pa-backside.mts
@@ -0,0 +1,41 @@
+// Play action's backside end (Integration, 2026-11-16, from the QB lane's paired staged runs: PA sacks 15-20% vs 5% on
+// dropbacks, DE_W the sacker on most). Staged plays on develop, the same fronts on PA (pa_flood, pa_post_dig, pa_shot)
+// and on straight dropbacks with the same back job (post_cross / seam_slant: back 'block'; flood: back on a route), from
+// gun_doubles_11 / ace_11 / gun_trey_11 / ace_12 x cover1 / cover3 x rosters 1-6 x seeds 1-2. For DE_W (the end away from
+// the strength) per play: who the protection first assigns him (slot, time), who first engages him (slot, time), the
+// back's fake side and where the back is at 0.8 s relative to DE_W (lateral yd), when DE_W first gets within 2 yd of the
+// QB (before the ball is out), and whether he sacks.
+// usage: [PAB_GRID=qb] [CONCEPT_DROPS=1 QB_FOOTWORK=1] node --import tsx scripts/diag/pass-operators/pa-backside.mts
+const W = process.cwd();
+const { PlaySim } = await import(`${W}/src/sim/playsim.ts`);
+const { nativeTraceSetup } = await import(`${W}/scripts/diag/command-trace.ts`);
+const rows: any[] = [];
+// PAB_GRID=qb: the QB lane's drop-staged.ts grid (gun_doubles_11; eight coverages; rosters 3 / 7 / 11 / 19; seeds 1-6).
+const QBG = process.env.PAB_GRID === 'qb';
+const FORMS = QBG ? ['gun_doubles_11'] : ['gun_doubles_11', 'ace_11', 'gun_trey_11', 'ace_12'];
+const COVS = QBG ? ['cover1', 'cover2man', 'cover2', 'tampa2', 'cover3', 'cover3_match', 'cover4', 'cover6'] : ['cover1', 'cover3'];
+const ROSTERS = QBG ? [3, 7, 11, 19] : [1, 2, 3, 4, 5, 6], SEEDS = QBG ? [1, 2, 3, 4, 5, 6] : [1, 2];
+for (const concept of ['pa_flood', 'pa_post_dig', 'pa_shot', 'post_cross', 'seam_slant', 'flood']) for (const formation of FORMS)
+  for (const coverage of COVS) for (const roster of ROSTERS) for (const seed of SEEDS) {
+    let sim: any; try { sim = new PlaySim(nativeTraceSetup({ coverage, concept, seed, roster, formation, flip: false })); } catch { continue; }
+    const de = sim.defense.find((d: any) => d.slot === 'DE_W'); if (!de) continue;
+    const back = sim.slot('RB');
+    const r: any = { concept, formation, pa: concept.startsWith('pa_'), assigned: null, engaged: null, reach: null, sack: false, backLat: null, deSide: Math.sign(de.pos.y - sim.ballY), strongSign: sim.offAlign.strongSign, backKind0: back?.behavior?.kind };
+    while (sim.phase === 'live' && sim.t < 4) {
+      sim.tick();
+      if (!r.assigned) { const coord = sim.offense.find((a: any) => a.behavior?.coord)?.behavior?.coord; if (coord) for (const [k, v] of coord.assigned) if (v === de) { r.assigned = { slot: k.slot, t: +sim.t.toFixed(2) }; break; } }
+      if (!r.engaged && de.engagement) r.engaged = { slot: de.engagement.blocker.slot, t: +sim.t.toFixed(2) };
+      if (r.backLat === null && back && sim.t >= 0.8) r.backLat = +((back.pos.y - de.pos.y) * r.deSide).toFixed(2);
+      if (!r.reach && sim.throwAt < 0 && Math.hypot(de.pos.x - sim.qb.pos.x, de.pos.y - sim.qb.pos.y) <= 2) r.reach = +sim.t.toFixed(2);
+    }
+    r.sack = sim.events.some((e: any) => e.type === 'sack' && e.a === de.idx);
+    r.anySack = sim.events.some((e: any) => e.type === 'sack');
+    rows.push(r);
+  }
+const pc = (n: number, d: number) => `${(100 * n / Math.max(1, d)).toFixed(0)}%`;
+const q = (v: number[]) => { const z = v.filter(Number.isFinite).sort((a, b) => a - b); return z.length ? z[Math.floor((z.length - 1) / 2)] : NaN; };
+const cnt = (S: any[], f: (r: any) => any) => S.reduce((m: any, r) => { const k = f(r) ?? 'nobody'; m[k] = (m[k] ?? 0) + 1; return m; }, {});
+for (const c of ['pa_flood', 'pa_post_dig', 'pa_shot', 'post_cross', 'seam_slant', 'flood']) {
+  const S = rows.filter((r) => r.concept === c); if (!S.length) continue;
+  console.log(`${c} (n ${S.length}): DE_W first assigned to ${JSON.stringify(cnt(S, (r) => r.assigned?.slot))} at p50 ${q(S.filter((r) => r.assigned).map((r) => r.assigned.t))} s | first engaged by ${JSON.stringify(cnt(S, (r) => r.engaged?.slot))} at p50 ${q(S.filter((r) => r.engaged).map((r) => r.engaged.t))} s | reached the QB ${pc(S.filter((r) => r.reach !== null).length, S.length)} at p50 ${q(S.filter((r) => r.reach !== null).map((r) => r.reach))} s | DE_W sacks ${S.filter((r) => r.sack).length} of ${S.filter((r) => r.anySack).length} | back at 0.8 s, yd toward DE_W's side of him (+ = beyond him, outside) p50 ${q(S.map((r) => r.backLat))} | DE_W on the weak side ${pc(S.filter((r) => r.deSide !== r.strongSign).length, S.length)}`);
+}
