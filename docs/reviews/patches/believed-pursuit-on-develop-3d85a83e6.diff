diff --git a/test/believed-pursuit.test.ts b/test/believed-pursuit.test.ts
new file mode 100644
index 000000000..bdca47f88
--- /dev/null
+++ b/test/believed-pursuit.test.ts
@@ -0,0 +1,53 @@
+// BELIEVED_PURSUIT (Flex with Defense, 2026-11-24; outside audit #7's staged case): a pursuer's forecast of the carrier does not
+// move when only the carrier's hidden top speed changes; it reads what he believes of him (with BELIEVED_BODY), not the truth.
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); });
+
+async function aimSpread(flags: Record<string, string>) {
+  for (const [k, v] of Object.entries(flags)) vi.stubEnv(k, v);
+  vi.resetModules();
+  const { sceneSim } = await import('../src/lab/coverage-scene.js');
+  const { pursuitPoint } = await import('../src/sim/behaviors/common.js');
+  // A fresh scene for each hidden top speed, run to the same moment; only the call sees the change (pursuit keeps a commitment
+  // per pursuer, so two calls on one scene would not be independent).
+  const aimAt = (dv: number) => {
+    const sim = sceneSim({ formation: 'gun_doubles_11', coverage: 'cover3', strong: { 1: 'go' } });
+    const step = sim as unknown as { tick(): void };
+    while (sim.t < 1.5) step.tick();
+    const carrier = sim.offense.find((o) => o.slot === 'Z')!, d = sim.defense.find((x) => x.slot === 'FS')!;
+    (carrier.body.profile as { vmax: number }).vmax += dv;
+    return pursuitPoint(sim, d, carrier);
+  };
+  const lo = aimAt(-1), hi = aimAt(+1);
+  return Math.hypot(lo.x - hi.x, lo.y - hi.y);
+}
+
+describe('BELIEVED_PURSUIT: the carrier forecast reads the pursuer\'s belief', () => {
+  it('on, the carrier\'s hidden top speed does not move the aim; off, it can', async () => {
+    const on = await aimSpread({ BELIEVED_BODY: '1', BELIEVED_PURSUIT: '1', TRACK_PURSUIT: '0' });
+    const off = await aimSpread({ BELIEVED_BODY: '1', BELIEVED_PURSUIT: '0', TRACK_PURSUIT: '0' });
+    expect(on).toBeLessThan(1e-9);
+    expect(off).toBeGreaterThan(0.05); // off, the true top speed moves it
+  }, 60_000);
+
+  it('a belief below the speed he sees never slows the forecast: seen speed is proven at once (Defense\'s case)', async () => {
+    const aim = async (flags: Record<string, string>, briefed: boolean) => {
+      for (const [k, v] of Object.entries(flags)) vi.stubEnv(k, v);
+      vi.resetModules();
+      const { sceneSim } = await import('../src/lab/coverage-scene.js');
+      const { pursuitPoint } = await import('../src/sim/behaviors/common.js');
+      const sim = sceneSim({ formation: 'gun_doubles_11', coverage: 'cover3', strong: { 1: 'go' } });
+      const step = sim as unknown as { tick(): void };
+      while (sim.t < 2.0) step.tick();
+      const carrier = sim.offense.find((o) => o.slot === 'Z')!, d = sim.defense.find((x) => x.slot === 'FS')!;
+      // A belief far below what he is watching the man run (a staged briefing).
+      if (briefed && sim.beliefs) sim.beliefs.belief(d, carrier).add({ cap: 'vmax', value: 4, sd: 0.01, kind: 'measure', source: { kind: 'film', from: 'staged', play: 0, t: 0 } });
+      return pursuitPoint(sim, d, carrier);
+    };
+    const truth = await aim({ BELIEVED_BODY: '1', BELIEVED_PURSUIT: '0' }, false);
+    const low = await aim({ BELIEVED_BODY: '1', BELIEVED_PURSUIT: '1' }, true);
+    // TRACK_PURSUIT (default on): no acceleration term, so both forecast at the speed he sees.
+    expect(Math.hypot(low.x - truth.x, low.y - truth.y)).toBeLessThan(1e-9);
+  }, 60_000);
+});
