 const hyp = (a: V2, b: V2) => Math.hypot(a.x - b.x, a.y - b.y);
+/** A zone defender's break on the ball (QB lane, 2026-11-25; measured on the staged cells: of 70 drivers 39 never closed on
+ * the point in flight, the rest from a median 0.24 s after the release, lane men 0.49 s): a man settled in his zone (slow in
+ * the passer's picture) breaks a reaction after his cue; one already running at the point is on his way. Smooth in his
+ * seen speed toward the point, no step: the full delay settled, none from REACT_ZONE_RUN yd/s. Chosen from that census. */
+export const REACT_ZONE = 0.2, REACT_ZONE_RUN = 2;
+const zoneReact = (d: SeenDefender, p: V2): number => {
+  const L = hyp(d.pos, p); if (L < 1e-3) return 0;
+  const toward = (d.vel.x * (p.x - d.pos.x) + d.vel.y * (p.y - d.pos.y)) / L;
+  return REACT_ZONE * (1 - Math.min(1, Math.max(0, toward / REACT_ZONE_RUN)));
+};
