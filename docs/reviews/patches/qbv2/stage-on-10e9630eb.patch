+    return out;
+  }
+
+  /** D on one candidate throw, on his picture. */
+  private judgeOption(h: V2Host, o: ThrowOption): Judged | null {
+    const r = this.receiver(h, o.ref); if (!r) return null;
+    const mech = h.mechanics(r, h.felt); if (!mech) return null;
