+    const path: V[] = [], heights: number[] = [];
+    for (let f = 0.1; f <= 1.0001; f += 0.1) { const b = arcPoint(from, v0, mech.T * f); path.push({ x: b.x, y: b.y }); heights.push(b.z); }
