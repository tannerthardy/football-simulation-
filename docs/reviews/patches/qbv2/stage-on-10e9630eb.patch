+  }
+
+  /** Where a look target is in his picture now. */
+  private where(h: V2Host, t: LookTarget): V | null {
+    if (t.kind === 'receiver') { const r = this.receiver(h, t.ref as ReceiverRef); return r ? h.predict(r, 0) ?? h.estimate(r).pos : null; }
