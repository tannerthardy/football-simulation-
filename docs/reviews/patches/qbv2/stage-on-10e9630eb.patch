+  watch(h: V2Host): void {
+    this.remember(h);
+    const r = this.plan.reads[this.cycle.readIdx]; if (!r) return;
+    const t: LookTarget = r.look.kind === 'receiver' ? { kind: 'receiver', ref: r.look.ref } : { kind: 'key', role: `${r.look.side ?? 'S'}:${r.look.role}` };
