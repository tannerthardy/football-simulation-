+        OL = sorted([i for i in p.who('O', 'OL') if p.pos(i, 0)[0] is not None], key=lambda i: p.pos(i, 0)[1])
+        qbs = p.who('O', 'QB')
+        if len(OL) < 5 or not qbs: continue
+        qb = qbs[0]
+        others = [i for i in p.who('O') if i != qb and i not in OL]
