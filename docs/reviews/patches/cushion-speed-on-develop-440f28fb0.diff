+/** CUSHION_SPEED staged gate (Flex with Coverage, 2026-11-24): one corner (CB_W, cover1_off, pure man) on X; X truly fast (forty
+ * -0.27) or truly slow (forty +0.25), no film (experience 0); the corner's belief of him set by one tight staged film entry: right
+ * (his true top speed) or wrong (the other man's). Twelve seeds on a go and on a hitch, the ball held. Per arm (medians): his speed
+ * cushion c, the cushion (corner past the receiver, yd) at 1.0 and 2.0 s, his turn time (hips open), on the go the receiver's lead
+ * at 3.0 s (+ = past him) and the share beaten by 1+ yd, on the hitch the distance at the settle (first speed under 2 yd/s after 0.8 s).
+ * usage: BELIEVED_BODY=1 [CUSHION_SPEED=1] node --import tsx scripts/diag/belief/cushion-speed-gate.mts */
+import { Rng } from '../../../src/core/rng.js';
+import { CENTER_Y } from '../../../src/core/field.js';
+import { generateTeam, pickDefense, pickOffense } from '../../../src/league/team.js';
+import { COVERAGE_BY_ID, FRONT_BY_ID } from '../../../src/playbook/defense.js';
+import { FORMATION_BY_ID } from '../../../src/playbook/formations.js';
+import type { PassConcept } from '../../../src/playbook/types.js';
+import { BELIEVED_BODY, BeliefStore } from '../../../src/sim/believed-body.js';
+import { CUSHION_SPEED, CUSHION_SPEED_ALIGN } from '../../../src/sim/behaviors/defense.js';
+import { PlaySim } from '../../../src/sim/playsim.js';
+import type { Agent } from '../../../src/sim/agent.js';
+import { derivePhysical } from '../../../src/players/physical.js';
+
+const off = generateTeam(new Rng(21), 'Offense', 'OFF', { strength: 0.6 });
+const def = generateTeam(new Rng(22), 'Defense', 'DEF', { strength: 0.6 });
+const formation = FORMATION_BY_ID.gun_doubles_11;
+const base = pickOffense(off, formation.personnel);
+const withForty = (d: number) => { const x = { ...base.X!, experience: 0, measurables: { ...base.X!.measurables, forty: base.X!.measurables.forty + d } }; return { ...base, X: x }; };
+const rosters = { fast: withForty(-0.27), slow: withForty(0.25) };
+const vtrue = { fast: derivePhysical(rosters.fast.X!).vmax, slow: derivePhysical(rosters.slow.X!).vmax };
+const defense = pickDefense(def, 'nickel');
+const med = (a: number[]) => { const b = a.filter(Number.isFinite).sort((p, q) => p - q); return b.length ? b[Math.floor(b.length / 2)] : NaN; };
+
+function rep(truth: 'fast' | 'slow', believed: 'fast' | 'slow' | null, route: 'go' | 'hitch', seed: number) {
+  const concept: PassConcept = { id: 'lab', name: 'lab', family: 'dropback', drop: 'gun5', strong: { 1: 'hitch', 2: 'hitch', 3: 'hitch', 4: 'hitch' },
+    weak: { 1: route, 2: 'hitch', 3: 'hitch', 4: 'hitch' }, back: 'block', progression: ['S1'], beats: [] };
+  const store = BELIEVED_BODY ? new BeliefStore(`gate-${seed}`) : undefined;
+  if (store && believed) store.brief(defense.CB_W!.id, rosters[truth].X!.id, { cap: 'vmax', value: vtrue[believed], sd: 0.03, kind: 'measure', source: { kind: 'film', from: 'staged', play: 0, t: 0 } });
+  const sim = new PlaySim({ offense: rosters[truth], defense, offCall: { formation, flip: false, kind: 'pass', pass: concept, label: 'lab' },
+    defCall: { personnel: 'nickel', front: FRONT_BY_ID.over, coverage: COVERAGE_BY_ID.cover1_off, pressure: null, label: 'lab' },
+    los: 40, ballY: CENTER_Y, firstDownX: 50, seed: 1000 + seed, beliefs: store });
+  sim.throwBall = () => undefined;
+  const R = sim.offense.find((o) => o.slot === 'X')!;
+  const corner = sim.defense.find((d) => (d.behavior as { target?: Agent }).target === R);
+  if (!corner) return null;
+  if (corner.player.id !== defense.CB_W!.id) return null; // the briefed corner must be the one on X
+  const out: Record<string, number> = { c1: NaN, c2: NaN, turn: NaN, lead3: NaN, settle: NaN, d0: corner.pos.x - sim.los };
+  const step = sim as unknown as { tick(): void };
+  while (sim.phase === 'live' && sim.t < 3.05) {
+    step.tick();
+    const t = sim.t;
+    if (Math.abs(t - 1.0) < sim.dt / 2) out.c1 = corner.pos.x - R.pos.x;
+    if (Math.abs(t - 2.0) < sim.dt / 2) out.c2 = corner.pos.x - R.pos.x;
+    if (!Number.isFinite(out.turn) && (corner.behavior as unknown as { hipsOpen?: boolean }).hipsOpen) out.turn = t;
+    if (Math.abs(t - 3.0) < sim.dt / 2) out.lead3 = R.pos.x - corner.pos.x;
+    if (!Number.isFinite(out.settle) && t > 0.8 && Math.hypot(R.vel.x, R.vel.y) < 2) out.settle = Math.hypot(R.pos.x - corner.pos.x, R.pos.y - corner.pos.y);
+  }
+  const tag = [...corner.tags].find((x) => x.startsWith('speed-cushion:'));
+  out.sc = tag ? Number(tag.split(':')[1]) : 0;
+  return out;
+}
+console.log(`BELIEVED_BODY=${BELIEVED_BODY ? 1 : 0} CUSHION_SPEED=${CUSHION_SPEED ? 1 : 0} CUSHION_SPEED_ALIGN=${CUSHION_SPEED_ALIGN ? 1 : 0}; X true vmax fast ${vtrue.fast.toFixed(2)}, slow ${vtrue.slow.toFixed(2)}`);
+console.log('| X truly | corner believes | route | c (yd) | aligned (yd off) | cushion 1.0 s | cushion 2.0 s | turn (s) | go: lead at 3.0 s | go: beaten 1+ yd | hitch: distance at the settle |');
+console.log('|---|---|---|---|---|---|---|---|---|---|---|');
+for (const truth of ['fast', 'slow'] as const) for (const believed of (BELIEVED_BODY ? ['fast', 'slow'] : [null]) as Array<'fast' | 'slow' | null>) for (const route of ['go', 'hitch'] as const) {
+  const R = Array.from({ length: 12 }, (_, i) => rep(truth, believed, route, i + 1)).filter((x): x is Record<string, number> => !!x);
+  const g = (k: string) => med(R.map((r) => r[k]));
+  const beaten = route === 'go' ? `${R.filter((r) => r.lead3 > 1).length}/${R.length}` : '-';
+  console.log(`| ${truth} | ${believed ?? 'truth (flag off path)'}${believed && believed !== truth ? ' (wrong)' : ''} | ${route} | ${g('sc').toFixed(2)} | ${g('d0').toFixed(2)} | ${g('c1').toFixed(2)} | ${g('c2').toFixed(2)} | ${g('turn').toFixed(2)} | ${route === 'go' ? g('lead3').toFixed(2) : '-'} | ${beaten} | ${route === 'hitch' ? g('settle').toFixed(2) : '-'} |`);
+}
