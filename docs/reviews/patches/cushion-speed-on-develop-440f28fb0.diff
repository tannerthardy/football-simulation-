diff --git a/test/cushion-speed.test.ts b/test/cushion-speed.test.ts
new file mode 100644
index 000000000..34980304e
--- /dev/null
+++ b/test/cushion-speed.test.ts
@@ -0,0 +1,39 @@
+// CUSHION_SPEED / CUSHION_SPEED_ALIGN (Flex with Coverage, 2026-11-24): a man corner's room, alignment and turn follow the speed
+// edge he believes he gives up to his man. Staged on one snap (gate: scripts/diag/belief/cushion-speed-gate.mts, 12 seeds).
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); });
+
+async function corner(flags: Record<string, string>, believedFast: boolean) {
+  for (const [k, v] of Object.entries({ BELIEVED_BODY: '1', ...flags })) vi.stubEnv(k, v);
+  vi.resetModules();
+  const { Rng } = await import('../src/core/rng.js');
+  const { CENTER_Y } = await import('../src/core/field.js');
+  const { generateTeam, pickDefense, pickOffense } = await import('../src/league/team.js');
+  const { COVERAGE_BY_ID, FRONT_BY_ID } = await import('../src/playbook/defense.js');
+  const { FORMATION_BY_ID } = await import('../src/playbook/formations.js');
+  const { BeliefStore } = await import('../src/sim/believed-body.js');
+  const { PlaySim } = await import('../src/sim/playsim.js');
+  const off = generateTeam(new Rng(21), 'O', 'O', { strength: 0.6 }), def = generateTeam(new Rng(22), 'D', 'D', { strength: 0.6 });
+  const formation = FORMATION_BY_ID.gun_doubles_11, roster = pickOffense(off, formation.personnel), defense = pickDefense(def, 'nickel');
+  const store = new BeliefStore('t');
+  store.brief(defense.CB_W!.id, roster.X!.id, { cap: 'vmax', value: believedFast ? 10.9 : 8.8, sd: 0.03, kind: 'measure', source: { kind: 'film', from: 'staged', play: 0, t: 0 } });
+  const pass = { id: 'lab', name: 'lab', family: 'dropback' as const, drop: 'gun5' as const, strong: { 1: 'hitch', 2: 'hitch', 3: 'hitch', 4: 'hitch' },
+    weak: { 1: 'go', 2: 'hitch', 3: 'hitch', 4: 'hitch' }, back: 'block', progression: ['S1' as const], beats: [] };
+  const sim = new PlaySim({ offense: roster, defense, offCall: { formation, flip: false, kind: 'pass', pass, label: 'lab' },
+    defCall: { personnel: 'nickel', front: FRONT_BY_ID.over, coverage: COVERAGE_BY_ID.cover1_off, pressure: null, label: 'lab' },
+    los: 40, ballY: CENTER_Y, firstDownX: 50, seed: 1001, beliefs: store });
+  return sim.defense.find((d) => d.slot === 'CB_W')!.pos.x - sim.los;
+}
+
+describe('CUSHION_SPEED_ALIGN: the off corner aligns by the speed edge he believes', () => {
+  it('deeper on a man he believes fast, shallower on one he believes slow, within the taught band; off, the same depth', async () => {
+    const fast = await corner({ CUSHION_SPEED_ALIGN: '1' }, true), slow = await corner({ CUSHION_SPEED_ALIGN: '1' }, false);
+    const base = await corner({ CUSHION_SPEED_ALIGN: '0' }, true), baseSlow = await corner({ CUSHION_SPEED_ALIGN: '0' }, false);
+    expect(base).toBeCloseTo(baseSlow, 9);
+    expect(fast).toBeGreaterThan(base + 1);
+    expect(slow).toBeLessThan(base); // shallower, to the band's floor at most
+    expect(fast).toBeLessThanOrEqual(8 + 1e-9);
+    expect(slow).toBeGreaterThanOrEqual(5 - 1e-9);
+  }, 60_000);
+});
