diff --git a/scripts/diag/pass-operators/attached-align.py b/scripts/diag/pass-operators/attached-align.py
new file mode 100644
index 00000000..1965c80c
--- /dev/null
+++ b/scripts/diag/pass-operators/attached-align.py
@@ -0,0 +1,44 @@
+# Alignment over an attached end at the snap, NFL tracking vs sim exports, one operator (#35 item 2; Integration: is the
+# collision angle alignment?). Common format (offense +x, line at x = 0). Attached end as attached-release.py (a TE <= 1.5
+# yd off the line, 0.5-2.5 yd outside the last lineman), every pass play (on a route or not). His man: the defender (DL or
+# LB) at the snap 0-3 yd ahead of him whose lateral offset from him (+ = outside the end) is the outermost within -1.5 ..
+# +3.5 yd, i.e. the man on the edge of the attached side. Reported: that man's offset and depth (p10/25/50/75/90), the
+# share with nobody there, his group (DL / LB), and the same split by the defense's front where the export has one (sim
+# rows carry 'front' in cell when present; NFL rows by the number of DL at the snap: 3, 4, 5+).
+# usage: python3 scripts/diag/pass-operators/attached-align.py <plays.jsonl.gz> ...
+import sys, os, json, gzip, collections
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'mechanics'))
+from metrics import Play
+q = lambda v, f=.5: sorted(v)[int(f * (len(v) - 1))] if v else float('nan')
+for path in sys.argv[1:]:
+    rows = []
+    for line in gzip.open(path, 'rt'):
+        r = json.loads(line); r = r.get('common', r)
+        if r.get('kind') != 'pass' or not r.get('xy'): continue
+        p = Play(r)
+        OL = [i for i in p.who('O', 'OL') if p.pos(i, 0)[0] is not None]
+        if len(OL) < 5: continue
+        ys = [p.pos(i, 0)[1] for i in OL]
+        D = [i for i in p.who('D') if r['players'][i]['group'] in ('DL', 'LB') and p.pos(i, 0)[0] is not None]
+        ndl = sum(1 for i in D if r['players'][i]['group'] == 'DL')
+        for i in p.who('O', 'TE'):
+            x0, y0 = p.pos(i, 0)
+            if x0 is None or x0 < -1.5: continue
+            out = 1 if y0 > (min(ys) + max(ys)) / 2 else -1
+            w = (y0 - (max(ys) if out > 0 else min(ys))) * out
+            if not (0.5 <= w <= 2.5): continue
+            C = [(d, (p.pos(d, 0)[1] - y0) * out, p.pos(d, 0)[0] - x0) for d in D]
+            C = [c for c in C if 0 <= c[2] <= 3 and -1.5 <= c[1] <= 3.5]
+            man = max(C, key=lambda c: c[1]) if C else None
+            rows.append({'off': man[1] if man else None, 'depth': man[2] if man else None, 'grp': r['players'][man[0]]['group'] if man else None,
+                         'front': (r.get('cell') or {}).get('front') or f'{min(ndl, 5)}DL'})
+    def line(lab, S):
+        M = [x for x in S if x['off'] is not None]
+        if not S: return f'  {lab}: none'
+        g = collections.Counter(x['grp'] for x in M)
+        return (f"  {lab} n {len(S)}: nobody {100*(len(S)-len(M))/len(S):.0f}% | outside the end p10/25/50/75/90 " + '/'.join(f"{q([x['off'] for x in M], f):.2f}" for f in (.1, .25, .5, .75, .9))
+                + f" yd | depth p25/50/75 " + '/'.join(f"{q([x['depth'] for x in M], f):.2f}" for f in (.25, .5, .75)) + f" | DL {100*g['DL']/max(1,len(M)):.0f}% LB {100*g['LB']/max(1,len(M)):.0f}%")
+    print(f'{os.path.basename(path)}: attached ends on pass plays {len(rows)}')
+    print(line('all', rows))
+    for fr, n in collections.Counter(x['front'] for x in rows).most_common(6):
+        if n >= 20: print(line(f'front {fr}', [x for x in rows if x['front'] == fr]))
diff --git a/scripts/diag/pass-operators/attached-rusher-lane.mts b/scripts/diag/pass-operators/attached-rusher-lane.mts
new file mode 100644
index 00000000..c8c68b47
--- /dev/null
+++ b/scripts/diag/pass-operators/attached-rusher-lane.mts
@@ -0,0 +1,40 @@
+// Where the rusher who hits an attached end was going (#35 item 2 (b)). Staged double_outs (as attached-release.mts):
+// for the first DL whose body touches the end before 2 s, his rush gap and plan, his lane point's lateral offset from
+// the end's snap spot (+ = outside the end), his own snap offset from the end, and the bearing of his requested velocity
+// against the line to the end in the 0.3 s before the touch (0 = straight at him).
+// usage: [RELEASE_COMMIT=1 ...] node --import tsx scripts/diag/pass-operators/attached-rusher-lane.mts
+const W = process.cwd();
+const { PlaySim } = await import(`${W}/src/sim/playsim.ts`);
+const { nativeTraceSetup } = await import(`${W}/scripts/diag/command-trace.ts`);
+const { gapY } = await import(`${W}/src/playbook/alignment.ts`);
+const rows: any[] = [];
+for (const formation of ['gun_trey_11', 'ace_11', 'ace_12', 'gun_wing_12']) for (const coverage of ['cover1', 'cover3', 'cover2', 'cover4']) for (let roster = 1; roster <= 6; roster++) for (const seed of [1, 2]) {
+  const sim: any = new PlaySim(nativeTraceSetup({ coverage, concept: 'double_outs', seed, roster, formation, flip: false }));
+  const ends = sim.offense.filter((a: any) => sim.offAlign.spots[a.slot]?.inline);
+  const st = new Map<any, any>(); const hist = new Map<any, any[]>();
+  const by = sim.ballY;
+  const y0 = new Map<any, number>(sim.agents.map((x: any) => [x, x.pos.y]));
+  while (sim.phase === 'live' && sim.t < 2.0) {
+    sim.tick();
+    for (const a of ends) {
+      const H = hist.get(a) ?? []; hist.set(a, H);
+      H.push(sim.defense.map((d: any) => ({ d, req: sim.cmds[sim.agents.indexOf(d)]?.vel, dp: { ...d.pos }, ap: { ...a.pos } })));
+      if (H.length > 13) H.shift();
+      if (st.has(a)) continue;
+      for (const d of sim.defense) if ((d.player.position === 'EDGE' || d.player.position === 'DT') && Math.hypot(d.pos.x - a.pos.x, d.pos.y - a.pos.y) <= a.profile.radius + d.profile.radius + 0.15) {
+        const b = d.behavior, out = Math.sign(y0.get(a)! - by) || 1;
+        let lane = NaN; try { if (gapY && b?.laneGap) lane = (gapY(sim.offAlign, b.laneGap, b.gapSign) - y0.get(a)!) * out; } catch {}
+        const bear = H.map((fr) => fr.find((f: any) => f.d === d)).filter((f: any) => f?.req && Math.hypot(f.req.x, f.req.y) > 1).map((f: any) => {
+          const tx = f.ap.x - f.dp.x, ty = f.ap.y - f.dp.y; return Math.acos(Math.max(-1, Math.min(1, (tx * f.req.x + ty * f.req.y) / (Math.hypot(tx, ty) * Math.hypot(f.req.x, f.req.y))))) * 180 / Math.PI; });
+        st.set(a, { slot: d.slot, gap: b?.gap, laneGap: b?.laneGap, plan: b?.plan, kind: b?.kind, tags: [...d.tags].filter((x: string) => /rush|arc|twist|game|key|squeeze/.test(x)).join(','), snapOff: +((y0.get(d)! - y0.get(a)!) * out).toFixed(2), lane: +lane.toFixed(2), bearing: bear.length ? +bear.sort((p: number, q: number) => p - q)[Math.floor(bear.length / 2)].toFixed(0) : null });
+        break;
+      }
+    }
+  }
+  for (const v of st.values()) rows.push(v);
+}
+const C = (k: string) => rows.reduce((m: any, r) => (m[r[k]] = (m[r[k]] ?? 0) + 1, m), {});
+const q = (v: number[], f = .5) => { const z = v.filter(Number.isFinite).sort((a, b) => a - b); return z.length ? z[Math.floor(f * (z.length - 1))] : NaN; };
+console.log(`touches ${rows.length} | by slot ${JSON.stringify(C('slot'))} | lane gap ${JSON.stringify(C('laneGap'))} | plan ${JSON.stringify(C('plan'))} | tags ${JSON.stringify(C('tags'))}`);
+console.log(`rusher's snap offset from the end (+ outside) p25/50/75 ${q(rows.map((r) => r.snapOff), .25)}/${q(rows.map((r) => r.snapOff))}/${q(rows.map((r) => r.snapOff), .75)} | his lane point's offset ${q(rows.map((r) => r.lane), .25)}/${q(rows.map((r) => r.lane))}/${q(rows.map((r) => r.lane), .75)} | request's bearing off the line to the end, 0.3 s before p25/50/75 ${q(rows.map((r) => r.bearing), .25)}/${q(rows.map((r) => r.bearing))}/${q(rows.map((r) => r.bearing), .75)} deg`);
+for (const p of Object.keys(C('plan'))) { const S = rows.filter((r) => String(r.plan) === p); console.log(`  plan ${p} n ${S.length}: snap ${q(S.map((r) => r.snapOff))}, lane ${q(S.map((r) => r.lane))}, bearing ${q(S.map((r) => r.bearing))}`); }
diff --git a/scripts/diag/pass-operators/attached-rusher-plan.mts b/scripts/diag/pass-operators/attached-rusher-plan.mts
new file mode 100644
index 00000000..0d95e79e
--- /dev/null
+++ b/scripts/diag/pass-operators/attached-rusher-plan.mts
@@ -0,0 +1,17 @@
+// Ends over / near an attached end (within 2.5 yd across, 3 deep at the snap), by slot and rush plan: how many touch the
+// attached end before 2 s (staged double_outs). 2026-11-16: DE_S power 96 / 96, DE_S speed 0 / 96, DE_W 0 / 48.
+const W = process.cwd();
+const { PlaySim } = await import(`${W}/src/sim/playsim.ts`);
+const { nativeTraceSetup } = await import(`${W}/scripts/diag/command-trace.ts`);
+const C: any = {};
+for (const formation of ['gun_trey_11', 'ace_11', 'ace_12', 'gun_wing_12']) for (const coverage of ['cover1', 'cover3', 'cover2', 'cover4']) for (let roster = 1; roster <= 6; roster++) for (const seed of [1, 2]) {
+  const sim: any = new PlaySim(nativeTraceSetup({ coverage, concept: 'double_outs', seed, roster, formation, flip: false }));
+  const ends = sim.offense.filter((a: any) => sim.offAlign.spots[a.slot]?.inline);
+  const de = sim.defense.filter((d: any) => d.slot === 'DE_S' || d.slot === 'DE_W');
+  const hit = new Set<string>();
+  const near = (a: any) => de.filter((d: any) => Math.abs(d.pos.y - a.pos.y) < 2.5 && Math.abs(d.pos.x - a.pos.x) < 3);
+  const pairs = ends.flatMap((a: any) => near(a).map((d: any) => [a, d]));
+  while (sim.phase === 'live' && sim.t < 2.0) { sim.tick(); for (const [a, d] of pairs) if (Math.hypot(d.pos.x - a.pos.x, d.pos.y - a.pos.y) <= a.profile.radius + d.profile.radius + 0.15) hit.add(a.slot + d.slot); }
+  for (const [a, d] of pairs) { const k = `${d.slot} ${d.behavior?.plan ?? d.behavior?.kind}`; C[k] = C[k] ?? [0, 0]; C[k][0]++; if (hit.has(a.slot + d.slot)) C[k][1]++; }
+}
+console.log('end over / near an attached end: [n, touched]', C);
diff --git a/scripts/diag/pass-operators/power-rep.mts b/scripts/diag/pass-operators/power-rep.mts
new file mode 100644
index 00000000..968c294e
--- /dev/null
+++ b/scripts/diag/pass-operators/power-rep.mts
@@ -0,0 +1,44 @@
+// POWER_AIM's reads (#35 item 2b; Integration's gate 4). Staged pass plays, two sets: attached-end looks (double_outs,
+// curl_flat from gun_trey_11 / ace_11 / ace_12 / gun_wing_12) and spread looks (four_verts, smash, dagger from
+// gun_doubles_11), cover1/2/3/4, rosters 1-6, seeds 1-2. Per edge rusher (DE_S, DE_W) by plan: his first pass
+// engagement (time, the blocker's slot), where on the blocker it lands (the rusher's offset across the blocker's chest
+// at the engagement, + = outside the blocker, and his bearing off the blocker's facing), the rep's control 0.5 s later,
