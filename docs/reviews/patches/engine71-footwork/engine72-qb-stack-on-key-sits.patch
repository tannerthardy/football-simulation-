+    b.startThrow = (a: any, s: any, ev: any) => { try { if (!decSplit && ev?.point) { const dist = Math.hypot(ev.point.x - a.pos.x, ev.point.y - a.pos.y), pr = b.pressure(a, s), atRel = pr.time - b.windup(a);
