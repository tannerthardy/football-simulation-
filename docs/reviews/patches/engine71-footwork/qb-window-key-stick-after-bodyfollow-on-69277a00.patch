+      pickerM: (rel.margins ?? []).find((m: any) => m.slot === picker?.slot) ?? null, pickerDef: rel.defs.find((d: any) => d.slot === picker?.slot) ?? null, margins: undefined, defs: undefined })); }
+  return res;
+};
+const seed = Number(process.argv[2] ?? 11);
