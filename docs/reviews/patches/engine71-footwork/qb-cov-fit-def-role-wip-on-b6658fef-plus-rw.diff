+      if (t >= T[T.length - 1]) return xs[T.length - 1];
+      let k = 0; while (k < T.length - 2 && t >= T[k + 1]) k++;
+      const f = (t - T[k]) / (T[k + 1] - T[k]);
+      return xs[k].map((v, j) => v + (xs[k + 1][j] - v) * f);
