+// BOX_DEPTH's staged read (#35; Integration's reads): the same staged dropbacks with BACK_CHECK on, BOX_DEPTH off / on.
+// Concepts whose back runs a route (curl_flat, hitch_out, flood, stick, smash, mesh) from gun_doubles_11 and gun_trips_11,
+// against cover1 / cover3 / cover2 / cover4 / cover0 (blitz), rosters 1-6, seeds 1-2. Per play: the box count at 3.5 / 5.0
+// yd (as the call counts it), the back's fate (released into his route and when; stayed in and blocked someone; never
+// released), the first defender within 2 yd of the QB before the ball is out and whether he was free (no blocker engaged
+// with him then) and where he came from (on the line / 3.5-5 yd backer / deeper), a target to the back, and sacks.
+// usage: BACK_CHECK=1 [BOX_DEPTH=1] node --import tsx scripts/diag/pass-operators/box-depth.mts
+const W = process.cwd();
+const { PlaySim } = await import(`${W}/src/sim/playsim.ts`);
+const { nativeTraceSetup } = await import(`${W}/scripts/diag/command-trace.ts`);
