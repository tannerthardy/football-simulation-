@@ -0,0 +1,17 @@
+// One staged dropback's protection declaration over time (BOX_DEPTH, #35): who each protector is assigned, the call's threats.
+// usage: BACK_CHECK=1 BACK_SHAPE=1 [BOX_DEPTH=1] node --import tsx scripts/diag/pass-operators/box-depth-trace.mts
+const W = process.cwd();
+const { PlaySim } = await import(`${W}/src/sim/playsim.ts`);
+const { nativeTraceSetup } = await import(`${W}/scripts/diag/command-trace.ts`);
+const sim: any = new PlaySim(nativeTraceSetup({ coverage: 'cover3', concept: 'curl_flat', seed: 1, roster: 1, formation: 'gun_doubles_11', flip: false }));
+const dir = sim.attackDir(sim.offense[0].team);
+const name = (x: any) => x ? `${x.slot}` : '-';
+for (let i = 0; i < 40 && sim.phase === 'live'; i++) {
+  sim.tick();
+  if ([1, 5, 10, 20, 30].includes(i)) {
+    const pp = sim.offense.filter((a: any) => a.behavior?.kind === 'pass-pro');
+    const coord = pp[0]?.behavior?.coord;
+    console.log(`t ${sim.t.toFixed(2)} assigned:`, pp.map((a: any) => `${a.slot}->${name(coord?.assigned.get(a))}${a.engagement ? '(E:' + a.engagement.defender.slot + ')' : ''}`).join(' '), '| called', [...(coord?.called ?? [])].map(name).join(','), '| protectors', coord?.protectors.map(name).join(','));
+  }
+}
+console.log('def depths', sim.defense.map((d: any) => `${d.slot}:${((sim.snapX[d.idx] - sim.los) * dir).toFixed(1)}`).join(' '));
