+export function flatOutsideOfTwo(p: RolePicture, side: 'S' | 'W'): boolean {
+  const two = p.receivers[`${side}2`];
+  const man = two ? resolveRole(p, 'flat', side) : null;
+  return !!two && !!man && out(p, man, side) - out(p, two, side) > OUTSIDE_OF_TWO;
