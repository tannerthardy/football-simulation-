+/** BACK_KEY: the off-ball backers in the box at the snap (1.5-6 yd off the
+ * ball, within 3 yd outside the tackles), and the back's read of them from
+ * his own picture: true once each has declared that he is not coming. */
+function checkKeys(sim: PlaySim, coord: ProtectionCoordinator): ((a: Agent, sim: PlaySim) => boolean) | null {
+  const dir = sim.attackDir('O');
+  const ol = sim.offense.filter(isOL).map(o => o.pos.y);
+  const lo = Math.min(...ol) - 3, hi = Math.max(...ol) + 3;
+  const keys = sim.defense.filter(d => {
+    const depth = (d.pos.x - sim.los) * dir;
+    return depth >= 1.5 && depth <= 6 && d.pos.y >= lo && d.pos.y <= hi;
+  }).map(d => ({ d, depth0: (d.pos.x - sim.los) * dir }));
+  if (!keys.length) return null;
+  return (a, s) => {
+    if (s.t > CHECK_LATEST) return true;
+    for (const k of keys) {
+      if (k.d.isDown(s.t) || k.d.engagement) continue;
+      // A teammate the line has given him to has him.
+      if ([...coord.assigned].some(([o, r]) => o !== a && r === k.d)) continue;
+      const seen = s.see(a, k.d);
+      const depth = (seen.pos.x - s.los) * dir;
+      const away = seen.vel.x * dir;
+      const out = seen.pos.y < lo - 1 || seen.pos.y > hi + 1;
+      if (depth >= k.depth0 + 0.5 || away > 1.5 || out) continue;
+      return false;
+    }
+    return true;
+  };
+}
