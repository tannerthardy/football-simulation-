+/** BLOCK_ANGLE (experimental, off; BLOCK_ANGLE=1 turns it on): do not clamp e.phi to [-0.95, 0.95] at formation.
+ * A blocker already past the defender's hip (|phi| >= 1.05) cannot form a legal front-side block; undisciplined
+ * blockers may instead attempt a cloth grab from behind (if HOLD_PERSIST=1), otherwise no block forms. Also includes
+ * hand control in e.win so a defender who has physically won the hands is recognized as winning the rep. */
+export const BLOCK_ANGLE = process.env.BLOCK_ANGLE === '1';
+/** HOLD_PERSIST (experimental, off; HOLD_PERSIST=1 turns it on): a declared cloth hold persists while within hold
+ * reach until holdUntil expires (~0.20-0.35 s by discipline) instead of being disengaged on the next tick (0.05 s)
+ * by `if (e.holding) return false;`; triggers on frame loss while still within reach and removes the e.control < -0.4
+ * lockout so beaten blockers can actually grab cloth for contact-holding.ts to adjudicate. */
+export const HOLD_PERSIST = process.env.HOLD_PERSIST === '1';
+/** SHED_EXIT (experimental, off; SHED_EXIT=1 turns it on): while shedding (`workOff`), open the defender's hips
+ * toward his exit travel instead of locking facing 90 deg off travel onto the blocker, and scale exit speed with
+ * blockShedding once hands clear. */
+export const SHED_EXIT = process.env.SHED_EXIT === '1';
+/** HELPER_HAND_FIGHT (experimental, off; HELPER_HAND_FIGHT=1 turns it on): replace raw rating+RNG drift in
+ * advanceRunHelperHands and pass createEngagement swipe dice rolls with the physical handLeverage / firstHands laws
+ * (ratings act through arm reach, hand speed, balance, and strength rather than awarding outcomes). */
+export const HELPER_HAND_FIGHT = process.env.HELPER_HAND_FIGHT === '1';
+const holdUntil = new WeakMap<Engagement, number>();
+const holdReachOf = (b: Agent, d: Agent): number =>
+  b.profile.radius + d.profile.radius + b.player.measurables.armIn / 36 + 0.25;
+
