 export const STAND: MoveCommand = { vel: { x: 0, y: 0 } };
 
+/** PURSUIT_ACCEL (experimental, off; PURSUIT_ACCEL=1 turns it on): in open space, a pursuer forecasting a live,
+ * unheld carrier moving slowly (out of a catch or post-miss cut) smoothly relaxes his forecast speed toward a
+ * position-typical running pace (no private carrier rating, preserving the pursuer's own anticipation tau). */
+export const PURSUIT_ACCEL = process.env.PURSUIT_ACCEL === '1';
+/** PURSUIT_OBLIQUE_GATHER (experimental, off; PURSUIT_OBLIQUE_GATHER=1 turns it on): smoothly blends the close-gather
+ * distance and short closing-time lead on oblique/crossing approaches by (1 - headOn) and incoming speed (no hard switch). */
+export const PURSUIT_OBLIQUE_GATHER = process.env.PURSUIT_OBLIQUE_GATHER === '1';
+
+function typicalCruiseSpeed(pos: string): number {
+  if (pos === 'WR' || pos === 'CB' || pos === 'FS' || pos === 'SS') return 7.0;
+  if (pos === 'RB') return 6.6;
+  if (pos === 'TE' || pos === 'FB' || pos === 'LB' || pos === 'QB') return 5.8;
+  return 4.8;
+}
+
+
 export function stand(facing?: number): MoveCommand {
   return { vel: { x: 0, y: 0 }, facing };
 }
@@ -157,7 +173,16 @@ export function pursuitPoint(sim: PlaySim, a: Agent, target: Agent, horizon = 3,
   // Recent acceleration is evidence for a short burst, not a promise of full
   // speed throughout the horizon. Reassess as new motion becomes visible.
   const tau = 0.3 + 0.3 * a.r('anticipation');
-  const V = clamp(sp + acceleration * tau, 0, target.profile.vmax);
+  const baseV = clamp(sp + acceleration * tau, 0, target.profile.vmax);
+  let V = baseV;
+  if (PURSUIT_ACCEL && seen.carrying === true && !seen.held) {
+    const cruise = typicalCruiseSpeed(target.player.position);
+    if (cruise > baseV) {
+      const wSpeed = clamp((sp - 0.3) / 1.2, 0, 1);
+      const wOpen = hasObservedFlight(a) ? 1 : clamp(((seen.pos.x - sim.los) * sim.attackDir(target.team) - 0.5) / 2.0, 0, 1);
+      V = baseV + (cruise - baseV) * wSpeed * wOpen;
+    }
+  }
   const straight = (t: number): Vec2 => {
     const d = V * t - (V - sp) * tau * (1 - Math.exp(-t / tau));
     return { x: seen.pos.x + heading.x * d, y: clamp(seen.pos.y + heading.y * d, 0, FIELD_WIDTH) };
@@ -328,11 +353,14 @@ export function gatheringApproach(a: Agent, seen: import('../perception.js').Per
     const pathMiss = dist * Math.abs(ux * seen.vel.y - uy * seen.vel.x) / Math.max(.1, carrierSpeed);
     const headOn = clamp((contact + .5 - pathMiss) / .75, 0, 1)
       * clamp((incoming - 1.5) / 1.5, 0, 1);
-    const close = clamp((contact + Math.max(2.5, stopping) - dist) / .75, 0, 1);
+    const wOblique = PURSUIT_OBLIQUE_GATHER ? (1 - headOn) * clamp((1.5 - incoming) / 1.5, 0, 1) : 0;
+    const closeReach = Math.max(2.5, stopping) * (1 - wOblique) + Math.max(1.2, 0.5 * stopping) * wOblique;
+    const close = clamp((contact + closeReach - dist) / .75, 0, 1);
     gather = Math.max(headOn, close);
     if (gather > 0) {
       // OPEN_FIELD: `upfield` (yd along x) keeps the arrival on top of the runner, shrinking to nothing at contact.
-      const goal = { x: seen.pos.x + upfield, y: clamp(seen.pos.y + offset, .3, FIELD_WIDTH - .3) };
+      const leadT = wOblique * clamp((dist - contact) / Math.max(2.5, a.speed + carrierSpeed), 0, 0.22);
+      const goal = { x: seen.pos.x + seen.vel.x * leadT + upfield, y: clamp(seen.pos.y + seen.vel.y * leadT + offset, .3, FIELD_WIDTH - .3) };
       const vel=movingArrivalVelocity(a.body,goal,seen.vel,a.profile.vmax*a.speedScale,
         contact,through,cutSkill,capacity);
       // A front tackler keeps driving through the near hip, rather than
