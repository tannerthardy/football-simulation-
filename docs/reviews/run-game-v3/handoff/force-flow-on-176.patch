     const line = surface + side * .5;
diff --git a/test/force-flow.test.ts b/test/force-flow.test.ts
new file mode 100644
index 00000000..772bf4b8
--- /dev/null
+++ b/test/force-flow.test.ts
@@ -0,0 +1,45 @@
+/** FORCE_FLOW (experimental, off): the moving force boundary also follows an
+ * outward track acquired before possession is identified. Off, the accepted
+ * carrying-only contract (force-track.test.ts) is unchanged. */
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { CENTER_Y } from '../src/core/field.js';
+import { Rng } from '../src/core/rng.js';
+import { generateTeam, pickDefense, pickOffense } from '../src/league/team.js';
+import { PASS_BY_ID } from '../src/playbook/concepts.js';
+import { COVERAGE_BY_ID, FRONT_BY_ID } from '../src/playbook/defense.js';
+import { FORMATION_BY_ID } from '../src/playbook/formations.js';
+import type { Perceived } from '../src/sim/perception.js';
+
+const offense = generateTeam(new Rng(41), 'Force track offense', 'FTO', { strength: .55 });
+const defense = generateTeam(new Rng(42), 'Force track defense', 'FTD', { strength: .55 });
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); });
+
+async function plan(on: boolean, side: number, carrying: boolean | null | undefined, vy: number) {
+  vi.stubEnv('FORCE_FLOW', on ? '1' : '0');
+  vi.resetModules();
+  const { PlaySim } = await import('../src/sim/playsim.js');
+  const { forceTrack } = await import('../src/sim/force-track.js');
+  const sim = new PlaySim({ offense: pickOffense(offense, '11'), defense: pickDefense(defense, 'nickel'),
+    offCall: { formation: FORMATION_BY_ID.gun_trey_11, flip: side > 0, kind: 'pass', pass: PASS_BY_ID.four_verts, label: 'flow' },
+    defCall: { personnel: 'nickel', front: FRONT_BY_ID.over, coverage: COVERAGE_BY_ID.cover3, pressure: null, label: 'flow' },
+    los: 40, ballY: CENTER_Y, firstDownX: 50, seed: 3 });
+  const a = sim.slot('FS')!;
+  a.runFit = { gap: 'D', side, kind: 'force', technique: 'attack', edge: 'box', pace: 'stack' };
+  a.body.pos = { x: 44, y: CENTER_Y + side * 5 }; a.body.vel = { x: -1, y: 0 }; a.body.facing = Math.PI;
+  const seen: Perceived = { pos: { x: 36.5, y: CENTER_Y + side * 5 }, vel: { x: 1, y: side * vy }, carrying, age: .25,
+    facing: 0, stance: null, pose: 'up' };
+  return forceTrack(a, seen, 40.3, CENTER_Y + side * 2, 0, side);
+}
+
+describe('FORCE_FLOW', () => {
+  it.each([-1, 1])('off: an outward back not yet seen carrying is not matched (side %s)', async (side) => {
+    for (const carrying of [false, null, undefined]) expect((await plan(false, side, carrying, 4)).velocity).toEqual({ x: 0, y: 0 });
+  });
+  it.each([-1, 1])('on: the same outward track is matched; inward or still tracks are not (side %s)', async (side) => {
+    for (const carrying of [false, null, undefined]) {
+      expect((await plan(true, side, carrying, 4)).velocity.y).toBe(side * 4);
+      expect((await plan(true, side, carrying, -3)).velocity).toEqual({ x: 0, y: 0 });
+      expect((await plan(true, side, carrying, 0)).velocity).toEqual({ x: 0, y: 0 });
+    }
+  });
+});
