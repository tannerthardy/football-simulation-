From 8d9da7fb1fea36ea72d1e8eefbd954a00bb45c20 Mon Sep 17 00:00:00 2001
From: Tanner Hardy <tannerh1243@gmail.com>
Date: Tue, 20 Oct 2026 20:30:53 +0000
Subject: [PATCH] Preview complete gathered pursuit commands before selection

---
 src/sim/approach-control.ts       | 20 ++++---
 src/sim/behaviors/common.ts       |  4 +-
 src/sim/run-fits.ts               |  4 +-
 test/approach-composition.test.ts | 88 +++++++++++++++++++++++++++++++
 4 files changed, 105 insertions(+), 11 deletions(-)
 create mode 100644 test/approach-composition.test.ts

diff --git a/src/sim/approach-control.ts b/src/sim/approach-control.ts
index ce0ac9f..8030267 100644
--- a/src/sim/approach-control.ts
+++ b/src/sim/approach-control.ts
@@ -16,9 +16,14 @@ const CHOICE_MARGIN = .1; // yd; avoid switching on a negligible forecast differ
 
 /** Only replace an unconstrained sprint that benefits from redirecting sooner.
  * Close strikes and the square-on approach remain owned by the tackle policy.
+ * Compose the caller's gathering technique before ranking, so the forecast
+ * consumes the complete request this helper returns. Composition must be pure;
+ * this is still a held free-space preview, before later movement modifiers.
  */
 export function chooseApproach(a: Agent, seen: Perceived, contact: number,
-  offset: number, original: MoveCommand, now: number): MoveCommand {
+  offset: number, original: MoveCommand, now: number,
+  compose: (command: MoveCommand) => MoveCommand = command => command): MoveCommand {
+  const composedOriginal = compose(original);
   const s = a.body.support;
   const dx = seen.pos.x - a.pos.x, dy = seen.pos.y - a.pos.y;
   const dist = Math.hypot(dx, dy), speed = Math.hypot(a.vel.x, a.vel.y);
@@ -27,13 +32,13 @@ export function chooseApproach(a: Agent, seen: Perceived, contact: number,
     || dist > contact + (speed + targetSpeed) * .6
     || a.isDown(now) || a.engagement || (s && (s.state !== 'up' || s.foot || s.strike
       || Math.hypot(s.lean.x, s.lean.y) > 1e-6
-      || Math.hypot(s.load.x, s.load.y) > 1e-6))) return original;
+      || Math.hypot(s.load.x, s.load.y) > 1e-6))) return composedOriginal;
   const ux = dx / dist, uy = dy / dist;
   const rvx = a.vel.x - seen.vel.x, rvy = a.vel.y - seen.vel.y;
   const closing = rvx * ux + rvy * uy;
   const across = -rvx * uy + rvy * ux;
   // A straight chase of a faster runner receives no speculative slow-down.
-  if (closing <= 0 || Math.abs(across) < 1) return original;
+  if (closing <= 0 || Math.abs(across) < 1) return composedOriginal;
 
   const tackle = a.r('tackling'), cutSkill = .85 + .35 * tackle;
   const capacity = s ? availability(s, supportParams(a.profile), fatigueFactor(a.body.energy)) : 1;
@@ -64,14 +69,15 @@ export function chooseApproach(a: Agent, seen: Perceived, contact: number,
     }
     return closest;
   }
-  let choice = original;
-  let best = score(original);
+  let choice = composedOriginal;
+  let best = score(composedOriginal);
   // A short forecast is useful for the upcoming plant, not for replacing a
   // distant interception. Only compare commands if the original path enters
   // the existing close-arrival region during this forecast. Fast players ten
   // yards apart can pass the cheap gate without any imminent approach.
-  if (best > contact + 2.5) return original;
-  for (const command of [arrival, brake]) {
+  if (best > contact + 2.5) return composedOriginal;
+  for (const candidate of [arrival, brake]) {
+    const command = compose(candidate);
     const distance = score(command);
     if (distance + CHOICE_MARGIN < best) { choice = command; best = distance; }
   }
diff --git a/src/sim/behaviors/common.ts b/src/sim/behaviors/common.ts
index 6811bbf..d731e81 100644
--- a/src/sim/behaviors/common.ts
+++ b/src/sim/behaviors/common.ts
@@ -216,8 +216,8 @@ export function chase(sim: PlaySim, a: Agent, target: Agent, horizon = 3): MoveC
   const original = { ...runThrough(a, p, { speed: effort }), effort };
   // A new grip may exist before its first solved load reaches body support.
   if (sim.bond?.tacklers.includes(a)) return original;
-  const far = chooseApproach(a, seen, contact, offset, original, sim.t);
-  return blendApproach(far, near, gather);
+  return chooseApproach(a, seen, contact, offset, original, sim.t,
+    command => blendApproach(command, near, gather));
 }
 
 export function ttr(a: Agent, p: Vec2, radius = 0): number {
diff --git a/src/sim/run-fits.ts b/src/sim/run-fits.ts
index db40e40..51e80b6 100644
--- a/src/sim/run-fits.ts
+++ b/src/sim/run-fits.ts
@@ -263,8 +263,8 @@ export function executeRunFit(a: Agent, sim: PlaySim, fallbackGap: Gap, fallback
     if (!premesh && seen.carrying === true && free && job.side * (seen.pos.y - gy) >= -contact) {
       const offset = aim.y-seen.pos.y;
       const { near, gather } = gatheringApproach(a,seen,contact,offset);
-      const approach = chooseApproach(a,seen,contact,offset,fit,sim.t);
-      return blendApproach(approach,near,gather);
+      return chooseApproach(a,seen,contact,offset,fit,sim.t,
+        command => blendApproach(command,near,gather));
     }
     return fit;
   }
diff --git a/test/approach-composition.test.ts b/test/approach-composition.test.ts
new file mode 100644
index 0000000..02a6556
--- /dev/null
+++ b/test/approach-composition.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it, vi } from 'vitest';
+import { CENTER_Y } from '../src/core/field.js';
+import { Rng } from '../src/core/rng.js';
+import { generateTeam, pickDefense, pickOffense } from '../src/league/team.js';
+import * as MovementPreview from '../src/physics/movement-preview.js';
+import type { Intent } from '../src/physics/world.js';
+import { PASS_BY_ID } from '../src/playbook/concepts.js';
+import { COVERAGE_BY_ID, FRONT_BY_ID } from '../src/playbook/defense.js';
+import { FORMATION_BY_ID } from '../src/playbook/formations.js';
+import { chooseApproach } from '../src/sim/approach-control.js';
+import { blendApproach } from '../src/sim/behaviors/common.js';
+import { movementObjective, withMovementObjective } from '../src/sim/movement-objective.js';
+import type { Perceived } from '../src/sim/perception.js';
+import { PlaySim } from '../src/sim/playsim.js';
+
+/** Synthetic free crossing approach, using the existing approach fixture's
+ * bodies. It tests the command/forecast boundary, not a promised tackle or
+ * reconstruction of a rounded recording. No preview result is substituted.
+ */
+function stage() {
+  const sim = new PlaySim({
+    offense: pickOffense(generateTeam(new Rng(19), 'O', 'OFF'), '11'),
+    defense: pickDefense(generateTeam(new Rng(20), 'D', 'DEF'), 'nickel'),
+    offCall: { formation: FORMATION_BY_ID.gun_doubles_11, flip: false, kind: 'pass',
+      pass: PASS_BY_ID.four_verts, label: 'composition contract' },
+    defCall: { personnel: 'nickel', front: FRONT_BY_ID.over, coverage: COVERAGE_BY_ID.cover3,
+      pressure: null, label: 'composition contract' },
+    los: 40, ballY: CENTER_Y, firstDownX: 50, seed: 19,
+  });
+  const runner = sim.slot('Z')!, defender = sim.slot('FS')!;
+  runner.body.pos = { x: 50, y: CENTER_Y }; runner.body.vel = { x: 6, y: 0 };
+  defender.body.pos = { x: 53, y: CENTER_Y + 6 };
+  defender.body.vel = { x: 6, y: -6 }; defender.body.facing = -Math.PI / 4;
+  const seen: Perceived = { pos: { ...runner.pos }, vel: { ...runner.vel }, facing: 0, stance: null };
+  const contact = runner.profile.radius + defender.profile.radius + defender.profile.reach * .65;
+  const original = withMovementObjective<Intent>({ vel: { x: 4.5, y: -8.6 }, effort: 1 },
+    { kind: 'fixed', point: { x: 55, y: CENTER_Y } });
+  const near = withMovementObjective<Intent>({ vel: { x: 4.5, y: -7 },
+    facing: Math.atan2(-6, -3), cutSkill: 1.07, posture: .57, push: .4 },
+    { kind: 'moving', point: seen.pos, velocity: seen.vel });
+  return { defender, seen, contact, original, near };
+}
+
+describe('approach forecasts the command that will actually be emitted', () => {
+  it('scores composed alternatives through the production World and returns the exact scored winner', () => {
+    const { defender, seen, contact, original, near } = stage();
+    const emitted: Intent[] = [];
+    const compose = vi.fn((command: Intent) => {
+      const final: Intent = blendApproach(command, near, .35);
+      emitted.push(final);
+      return final;
+    });
+    // Pass-through spy: each forecast still runs the production World.
+    const preview = vi.spyOn(MovementPreview, 'previewFreeMovement');
+    try {
+      const chosen = chooseApproach(defender, seen, contact, 0, original, 0, compose);
+      expect(preview).toHaveBeenCalledTimes(3);
+      expect(compose).toHaveBeenCalledTimes(3);
+      const scored = preview.mock.calls.map(call => call[1]);
+      for (const command of scored) {
+        expect(emitted).toContain(command);
+        expect(command.posture).toBe(near.posture);
+        expect(command.push).toBe(near.push);
+        expect(command.cutSkill).toBe(near.cutSkill);
+        expect(movementObjective(command)).toEqual(movementObjective(near));
+      }
+      // Recomposition after scoring creates a different unscored object; the
+      // chosen command must be the same complete object the forecast consumed.
+      expect(scored).toContain(chosen);
+      expect(chosen).not.toBe(original);
+    } finally { preview.mockRestore(); }
+  });
+
+  it('keeps exclusion cheap while returning its composed original, with identity as the default', () => {
+    const { defender, seen, contact, original, near } = stage();
+    defender.body.vel = { x: 0, y: 0 };
+    const final = blendApproach(original, near, .35);
+    const compose = vi.fn(() => final);
+    const preview = vi.spyOn(MovementPreview, 'previewFreeMovement');
+    try {
+      expect(chooseApproach(defender, seen, contact, 0, original, 0, compose)).toBe(final);
+      expect(compose).toHaveBeenCalledExactlyOnceWith(original);
+      expect(preview).not.toHaveBeenCalled();
+      expect(chooseApproach(defender, seen, contact, 0, original, 0)).toBe(original);
+      expect(movementObjective(original)).toEqual({ kind: 'fixed', point: { x: 55, y: CENTER_Y } });
+    } finally { preview.mockRestore(); }
+  });
+});
