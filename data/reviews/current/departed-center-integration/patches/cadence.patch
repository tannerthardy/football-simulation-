diff --git a/scripts/diag/saved-exchange.ts b/scripts/diag/saved-exchange.ts
new file mode 100644
index 0000000..12c6a59
--- /dev/null
+++ b/scripts/diag/saved-exchange.ts
@@ -0,0 +1,22 @@
+/** Portable, full-context snap inputs from PR #54. No game/prefix replay. */
+import {readFileSync} from 'node:fs';
+import {gunzipSync} from 'node:zlib';
+import assert from 'node:assert/strict';
+import {PlaySim, type PlaySetup} from '../../src/sim/playsim.js';
+import {CoverageScouting} from '../../src/sim/qbmind.js';
+import {ScoutingReport} from '../../src/sim/recognition.js';
+
+export const savedExchanges = JSON.parse(gunzipSync(readFileSync(
+  'test/fixtures/shotgun-exchange.json.gz')).toString());
+
+export function savedExchange(id: string): PlaySim {
+  const row = savedExchanges.inputs.find((r: {id: string}) => r.id === id);
+  assert(row, `Unknown saved exchange ${id}`);
+  const s = structuredClone(row.setup);
+  const setup: PlaySetup = {...s, energy: new Map(s.energy),
+    scouting: Object.assign(new ScoutingReport(), {...s.scouting, cells: new Map(s.scouting.cells)}),
+    coverageScouting: Object.assign(new CoverageScouting(), s.coverageScouting)};
+  const sim = new PlaySim(setup);
+  assert.deepEqual({...sim.rng}, row.expectedInitialRng, 'Saved native initialization changed');
+  return sim;
+}
diff --git a/src/sim/assign.ts b/src/sim/assign.ts
index a412b15..67af325 100644
--- a/src/sim/assign.ts
+++ b/src/sim/assign.ts
@@ -254,9 +254,11 @@ export class RunnerToMesh implements Behavior {
     // until the QB actually gives him the ball; onHandoff installs the run.
     // Running through an expired landmark used to strand him yards away.
     if (this.ride) {
-      // A stretch back takes the ball on the move: arrive running, then keep
-      // riding the track toward the aiming point until the QB puts it in.
-      if (d < .7) this.passed = true;
+      // Being close to the landmark is not permission to leave before the
+      // installed exchange window. Gun backs can start almost on the mesh.
+      // Keep approaching it until the QB can actually put the ball in, then
+      // ride through at the existing tempo (possession still comes from him).
+      if (d < .7 && sim.t >= this.meshTime - .15) this.passed = true;
       if (this.passed) return goTo(a, this.aim, { speed: .55, through: a.profile.vmax * .55 });
       return goTo(a, this.mesh, { speed, through: a.profile.vmax * .55 });
     }
