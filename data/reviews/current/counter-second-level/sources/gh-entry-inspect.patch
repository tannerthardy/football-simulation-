+/** A wrapper can start his installed backer approach through a visible opening.
+ * This checks clearance, not future interception or a guaranteed block. */
+import {closestOnSegment, type Vec2} from '../core/vec.js';
+import type {Perceived} from './perception.js';
+
+export interface PullEntryBody {seen: Perceived; radius: number}
+
+export function clearPullEntry(pos: Vec2, radius: number, backer: Perceived,
+  strike: number, bodies: PullEntryBody[], horizon: number): boolean {
+  if (backer.pose === 'down' || backer.pose === 'rising' || backer.pos.x <= pos.x) return false;
+  // Stop the tested corridor at first strike, not beyond the backer. These
+  // pictures already include observation age; advance only the next beat.
+  return [0,horizon].every(dt => {
+    const target={x:backer.pos.x+backer.vel.x*dt,y:backer.pos.y+backer.vel.y*dt};
+    const dx=target.x-pos.x,dy=target.y-pos.y,d=Math.hypot(dx,dy);
+    const scale=Math.max(0,d-strike)/Math.max(d,1e-12);
+    const end={x:pos.x+dx*scale,y:pos.y+dy*scale};
+    return bodies.every(b=>{
+      const point={x:b.seen.pos.x+b.seen.vel.x*dt,y:b.seen.pos.y+b.seen.vel.y*dt};
+      const near=closestOnSegment(point,pos,end).point;
+      return Math.hypot(point.x-near.x,point.y-near.y)>=radius+b.radius;
+    });
+  });
+}
