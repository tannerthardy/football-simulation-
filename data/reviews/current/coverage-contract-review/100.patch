+        : { pos: { x: 42, y: f.startY + (declaration === 'flat' ? f.out : -f.out) * 2 },
+          vel: { x: 1, y: (declaration === 'flat' ? f.out : -f.out) * 5 } });
+      f.update(.6); f.update(.8);
