+/** LEAD_IN (experimental, off): a power/counter lead wraps on the kick he can
+ * see (src/sim/behaviors/blocking.ts RunBlocker readKickLane/laneThreat).
+ * His turn-up follows his own picture of the installed kicker and end: 1.4 yd
+ * inside a kicked end (never outside the called hole), outside a seen log,
+ * never from the kicker's private 'block-log' tag. Turned up, the first
+ * unblocked defender to show in his lane becomes his man. */
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); });
+
+type Kick = 'kick' | 'log';
+
+/** Weak-side power from the I: the fullback kicks the end, the backside guard
+ * leads. The kicker and end are placed joined, the kicker inside the end
+ * ('kick') or on his outside ('log'); every body is held still and fully
+ * observed, so each picture is the placed scene. */
+async function scene(on: boolean, kick: Kick, tag = false) {
+  vi.stubEnv('LEAD_IN', on ? '1' : '0');
+  vi.resetModules();
+  const { makeSim, rosters } = await import('../scripts/diag/zone-lab/lab.js');
+  const { RunBlocker, playSideSign } = await import('../src/sim/behaviors/blocking.js');
+  const sim = makeSim({ concept: 'power', dir: 'weak', formation: 'i_pro_21', look: 'over3', roster: 'pair11', seed: 2 } as never, rosters());
+  const side = playSideSign(sim, sim.offCall.run!);
+  const plan = (o: (typeof sim.agents)[number]) => (o.behavior as InstanceType<typeof RunBlocker>).plan;
+  const lead = sim.offense.find(o => o.behavior instanceof RunBlocker && plan(o).kind === 'pull' && plan(o).pullRole === 'lead')!;
+  const kicker = sim.offense.find(o => o.behavior instanceof RunBlocker && plan(o).pullRole === 'kick')!;
+  const end = plan(kicker).target!, installed = plan(lead).target!;
+  const hole = plan(lead).pullPath!.at(-1)!.y;
+  const still = (a: (typeof sim.agents)[number], x: number, y: number) => { a.body.pos = { x, y }; a.body.vel = { x: 0, y: 0 }; };
+  // The end has squeezed 0.4 yd inside the called hole's outside; the kicker
+  // meets him from inside, or has been crossed and logs him from outside.
+  still(end, sim.los + .3, hole + side * .4);
+  still(kicker, sim.los - .3, end.pos.y + side * (kick === 'kick' ? -.75 : .6));
+  if (tag) kicker.tags.add('block-log');
+  // The lead is on his pull, at its first landmark.
+  const start = plan(lead).pullPath![0];
+  still(lead, start.x, start.y);
+  const observe = () => { for (let i = 0; i < 24; i++) sim.perception.record(sim.agents); };
+  observe();
+  sim.t = 1;
+  const intent = lead.behavior.update(lead, sim);
+  return { sim, side, lead, kicker, end, installed, hole, plan: plan(lead), intent, still, observe };
+}
+
+describe('LEAD_IN: the lead wraps on the kick he sees', () => {
+  it('turns up 1.4 yd inside a kicked end, outside a seen log, never off the tag', async () => {
+    const kick = await scene(true, 'kick');
+    const turn = kick.plan.pullPath!.at(-1)!;
+    expect((turn.y - kick.end.pos.y) * kick.side).toBeCloseTo(-1.4, 6);
+    expect((turn.y - kick.hole) * kick.side).toBeLessThan(0);
+    // The kicker's private log tag changes nothing he can see.
+    const tagged = await scene(true, 'kick', true);
+    expect(tagged.plan.pullPath).toEqual(kick.plan.pullPath);
+    expect(tagged.intent).toEqual(kick.intent);
+    // A seen log: the kicker joined on the end's outside sends him around it.
+    const log = await scene(true, 'log');
+    expect((log.plan.pullPath!.at(-1)!.y - log.kicker.pos.y) * log.side).toBeGreaterThan(.5);
+    // Control (off): the corner is the snap hole, moved only by the tag.
+    const off = await scene(false, 'kick'), offTagged = await scene(false, 'kick', true);
+    expect(off.plan.pullPath!.at(-1)!.y).toBe(off.hole);
+    expect(offTagged.plan.pullPath!.at(-1)!.y).not.toBe(offTagged.hole);
+  }, 60000);
+
+  it('turned up, takes the first unblocked defender to show in his lane', async () => {
+    const run = async (on: boolean) => {
+      const s = await scene(on, 'kick');
+      const { sim, side, lead, end, installed, still, observe } = s;
+      // The installed backer is far from the lane; one other backer is in it,
+      // stepping across it. Every other defender is out of the picture.
+      const crosser = sim.defense.find(d => d.slot.startsWith('LB') && d !== installed)!;
+      const lane = s.plan.pullPath!.at(-1)!;
+      for (const d of sim.defense) if (d !== end && d !== crosser) still(d, sim.los + 15, d.pos.y);
+      still(installed, sim.los + 5, lane.y - side * 6);
+      still(crosser, sim.los + 1.2, lane.y - side * .9);
+      crosser.body.vel = { x: 0, y: side * 2 };
+      // The lead has cleared the wall at his flat landmark and turns up.
+      const flat = s.plan.pullPath![1];
+      still(lead, sim.los - 1.6, flat.y);
+      observe();
+      sim.t = 2;
+      lead.behavior.update(lead, sim);
+      observe();
+      sim.t = 3;
+      lead.behavior.update(lead, sim);
+      return { target: s.plan.target, crosser, installed };
+    };
+    const on = await run(true), off = await run(false);
+    expect(on.target).toBe(on.crosser);
+    expect(off.target).toBe(off.installed);
+  }, 60000);
+});

