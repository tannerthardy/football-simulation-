+  /** LEAD_IN: the wrap's landmarks from this lead's own pictures of the
+   * installed kicker and end. Inside the kick he turns up LEAD_INSIDE inside
+   * the end's seen body, never outside the called hole: an end who widens
+   * opens the hole outside the lead; he does not move it. When the kicker is
+   * seen joined on the end's outside (a log) before he turns up, he goes
+   * around the log and stays committed to that side. Depth landmarks are the
+   * installed pull's. */
+  private readKickLane(a: Agent, sim: PlaySim, pair: NonNullable<RunBlockPlan['kickPair']>): { flat: Vec2; turn: Vec2 } {
+    const side = playSideSign(sim, sim.offCall.run!);
+    const k = sim.see(a, pair.kicker), e = sim.see(a, pair.end);
+    const reach = pair.kicker.profile.radius + pair.end.profile.radius + .1 + pair.kicker.player.measurables.armIn / 36 * .45;
+    const joined = Math.hypot(k.pos.x - e.pos.x, k.pos.y - e.pos.y) <= reach;
+    // The log is read before the turn-up; a lead already turned up inside
+    // the kick stays in that lane.
+    this.wrapOutside ||= this.pullIdx <= 1 && joined && (k.pos.y - e.pos.y) * side > .25;
+    const inside = Math.min(0, (e.pos.y - side * LEAD_INSIDE - pair.holeY) * side);
+    const turn = this.wrapOutside
+      ? { x: Math.max(sim.los + .5, k.pos.x + .6), y: k.pos.y + side * 1.1 }
+      : { x: sim.los + .5, y: pair.holeY + side * inside };
+    return { flat: { x: sim.los - 1.15, y: turn.y - side * .5 }, turn };
+  }
+
+  /** LEAD_IN: the first color in this lead's lane, from his own pictures. A
+   * second-level or nearer defender (seen within 5.5 yd of the line) shows
+   * when his seen motion, carried up to a second ahead, puts him across the
+   * lane between just behind the line and the second level; one with a
+   * teammate's seen body on him is already blocked, and the installed kicked
+   * end belongs to the kick. Those showing within one
+   * decision beat of the first are taken inside-out. The current man is kept
+   * when he is within reach or shows no later than that beat. */
+  private laneThreat(a: Agent, sim: PlaySim, current: Agent, pair: NonNullable<RunBlockPlan['kickPair']>): Agent {
+    const lane = this.plan.pullPath!.at(-1)!, side = playSideSign(sim, sim.offCall.run!), beat = a.mind.decisionInterval;
+    const held = sim.see(a, current);
+    const heldDistance = Math.hypot(held.pos.x - a.pos.x, held.pos.y - a.pos.y);
+    if (heldDistance < this.leadFitReach(a, current, held, heldDistance)) return current;
+    const mates = sim.offense.filter(o => o !== a && o !== sim.qb && o !== sim.carrier)
+      .map(o => ({ seen: sim.see(a, o), r: o.profile.radius }));
+    let currentAt: number | null = null;
+    const shows: { d: Agent; at: number; inside: number }[] = [];
+    for (const d of sim.defense) {
+      if (d === pair.end) continue;
+      const s = d === current ? held : sim.see(a, d);
+      if (s.pose === 'down' || s.pose === 'rising' || s.pos.x - sim.los > 5.5) continue;
+      if (mates.some(m => Math.hypot(m.seen.pos.x - s.pos.x, m.seen.pos.y - s.pos.y) < m.r + d.profile.radius + .35)) continue;
+      for (let tau = 0; tau <= 1 + 1e-9; tau += .1) {
+        const x = s.pos.x + s.vel.x * tau, y = s.pos.y + s.vel.y * tau;
+        if (x > sim.los - 1 && x < sim.los + 4.5 && Math.abs(y - lane.y) < 1 + d.profile.radius) {
+          shows.push({ d, at: tau, inside: (s.pos.y - lane.y) * side });
+          if (d === current) currentAt = tau;
+          break;
+        }
+      }
+    }
+    if (!shows.length) return current;
+    const first = Math.min(...shows.map(s => s.at));
+    if (currentAt !== null && currentAt <= first + beat) return current;
+    return shows.filter(s => s.at <= first + beat).sort((p, q) => p.inside - q.inside)[0].d;
+  }
+
+  /** LEAD_IN: the lead fits a man within his own strike reach, plus what
+   * their seen closing speed covers before his next decision. */
+  private leadFitReach(a: Agent, target: Agent, seen: Perceived, distance: number): number {
+    const strike = a.profile.radius + target.profile.radius + .1 + a.player.measurables.armIn / 36 * .45;
+    const d = Math.max(distance, 1e-6);
+    const closing = Math.max(0, -((seen.vel.x - a.vel.x) * (seen.pos.x - a.pos.x) + (seen.vel.y - a.vel.y) * (seen.pos.y - a.pos.y)) / d);
+    return strike + closing * a.mind.decisionInterval;
+  }
+
